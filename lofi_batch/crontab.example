# Install (edit absolute paths / GPU first):
#   crontab -e
# Paste one of the lines below.

# Every day at 03:00 — generate one package + try upload (1/day cap)
0 3 * * * cd /raid/user_davidoneil/virtual_singer_clip && GPU=1 SKIP_UPLOAD=0 bash lofi_batch/run_daily.sh >> output/lofi_batch/cron.log 2>&1

# Upload-only (if generation already queued): once per day
# 30 9 * * * cd /raid/user_davidoneil/virtual_singer_clip && YOUTUBE_PRIVACY=unlisted python lofi_batch/youtube_upload.py >> output/lofi_batch/cron.log 2>&1

