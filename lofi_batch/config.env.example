# Copy to config.env and source before run_docker.sh, or export inline:
#   GPU=1 TRACKS=20 DURATION=180 bash lofi_batch/run_docker.sh

# GPU index on the host (docker --gpus device=N)
GPU=1

# Docker image (pytorch 2.9 cuda13 — same as RVC / ACE-Step jobs)
IMAGE=a4898b757eac

# Tracks per prompt and seconds per track (~20 x 180s ≈ 1 hour)
TRACKS=20
DURATION=180

# ACE-Step DiT / LM
CONFIG_PATH=acestep-v15-xl-turbo
LM_MODEL=acestep-5Hz-lm-1.7B
BACKEND=pt

# Optional: fixed run id (default = timestamp YYYY-MM-DD_HHMM)
# RUN_ID=2026-08-03_1400

# Abort whole batch on first track failure (default: continue)
# FAIL_FAST=1
